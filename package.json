{
  "name": "deploy-rush",
  "version": "1.0.0",
  "description": "Deploy Rush — an arcade CI/CD release engineering game built with Phaser 3, TypeScript and Vite.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "server:install": "npm --prefix server install",
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev"
  },
  "keywords": [
    "phaser",
    "game",
    "arcade",
    "typescript",
    "vite",
    "cicd"
  ],
  "license": "MIT",
  "dependencies": {
    "phaser": "^3.80.1"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
