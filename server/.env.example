# Deploy Rush backend — copy to .env and adjust as needed.

PORT=8787

# Storage backend: supabase, sqlite, or json.
# When omitted, Supabase is selected if SUPABASE_URL is present; otherwise SQLite.
# With Docker Compose, explicitly set STORE=supabase (the default is sqlite).
STORE=

# Public Edge Function endpoint; privileged table access stays in the function.
SUPABASE_URL=
# Not required by the Express Edge adapter; retained for other deployment clients.
SUPABASE_PUBLISHABLE_KEY=

# Comma-separated list of allowed browser origins. Empty = allow all (dev).
ALLOWED_ORIGINS=

# Optional write auth for POST /api/scores.
SUBMIT_TOKEN=

# Extra banned handle substrings (comma-separated).
EXTRA_BLOCKLIST=

# Salt used to hash client IPs at rest for the Express server.
IP_HASH_SALT=

# Express trust proxy setting.
TRUST_PROXY=loopback
