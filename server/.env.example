# Deploy Rush backend — copy to .env and adjust as needed.
# All values are optional; sane defaults are used for local development.

# Port to listen on.
PORT=8787

# Storage backend: "sqlite" (default) or "json".
STORE=sqlite

# Comma-separated list of allowed browser origins. Empty = allow all (dev).
# Example: https://deploy-rush.example.com,https://booth.local
ALLOWED_ORIGINS=

# If set, POST /api/scores requires header: x-api-key: <this value>.
# Leave empty for an open booth leaderboard.
SUBMIT_TOKEN=

# Extra banned handle substrings (comma-separated), added to the built-in list.
EXTRA_BLOCKLIST=

# Salt used to hash client IPs at rest. Defaults to a random value per boot;
# set a stable secret in production if you want consistent hashes.
IP_HASH_SALT=

# Express "trust proxy" setting (default: loopback). Use 1 behind one proxy.
TRUST_PROXY=loopback
