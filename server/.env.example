# Deploy Rush backend — copy to .env and adjust as needed.

PORT=8787

# Storage backend: supabase, sqlite, or json.
# When omitted, Supabase is selected automatically if both Supabase variables
# below are present; otherwise the server falls back to SQLite.
STORE=

# Supabase Data API configuration. The publishable key is safe for browser/public
# distribution; direct table access is still blocked by RLS/revoked grants.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Comma-separated list of allowed browser origins. Empty = allow all (dev).
ALLOWED_ORIGINS=

# Optional write auth for POST /api/scores.
SUBMIT_TOKEN=

# Extra banned handle substrings (comma-separated).
EXTRA_BLOCKLIST=

# Salt used to hash client IPs at rest for the Express server.
IP_HASH_SALT=

# Express trust proxy setting.
TRUST_PROXY=loopback
