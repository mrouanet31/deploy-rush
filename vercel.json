{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "destination": "/deploy-rush/",
      "permanent": false
    },
    {
      "source": "/deploy-rush",
      "destination": "/deploy-rush/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/deploy-rush/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/deploy-rush/:path*",
      "destination": "/index.html"
    }
  ]
}
